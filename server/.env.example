# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME=TesfaBunna
APP_ENV=local
APP_DEBUG=true
# Base URL of this API. Used to build absolute asset URLs for uploads.
APP_URL=http://localhost:8000
PORT=8000

# Comma separated list of origins allowed to call the API.
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Option A - hosted database (Supabase, Neon, Railway, ...).
# When DATABASE_URL is set it replaces every DB_* value below.
# Keep the password percent-encoded exactly as the provider gave it to you.
# sslmode=require is rewritten to no-verify automatically, because pg treats
# `require` as `verify-full` and Supabase's certificate chain is not trusted.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require

# Option B - local PostgreSQL. Used when DATABASE_URL is empty.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=tesfabunna
DB_POOL_MIN=0
DB_POOL_MAX=10

# Force TLS when connecting. Leave false if your URL already sets sslmode.
DB_SSL=false

# ─────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────
# Name stored alongside the access token.
AUTH_TOKEN_NAME=admin-token
# Days before a token expires. 0 = tokens never expire (Laravel Sanctum default).
AUTH_TOKEN_TTL_DAYS=0
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────
# Uploads
# ─────────────────────────────────────────────────────────────
# Path is resolved relative to the server/ folder.
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_KB=5120